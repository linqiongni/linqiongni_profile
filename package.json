{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sync:financing": "rsync -a \"融资法务/\" \"public/financing-legal/\" --exclude README.md --exclude AGENTS.md --exclude MEMORY.md --exclude .workbuddy --exclude assets/.DS_Store",
    "sync:arbitration": "rsync -a \"商事仲裁/\" \"public/arbitration/\" --exclude .DS_Store",
    "sync:commercial-ops": "rsync -a \"商业运营法务/\" \"public/commercial-ops/\" --exclude .DS_Store --exclude .workbuddy",
    "sync:retail-ad": "rsync -a \"新零售与广告合规/\" \"public/retail-ad/\" --exclude .DS_Store --exclude .workbuddy",
    "sync:family-law": "rsync -a \"婚姻家事与遗产继承/\" \"public/family-law/\" --exclude .DS_Store --exclude _build",
    "sync:english": "rsync -a \"身边的英语/\" \"public/english/\" --exclude .DS_Store --exclude .workbuddy",
    "sync:logistics": "rsync -a \"跨境物流法务/\" \"public/logistics/\" --exclude .DS_Store --exclude .workbuddy",
    "check:english": "node scripts/check-english-scenes.cjs",
    "sync:all-static": "npm run sync:financing && npm run sync:commercial-ops && npm run sync:retail-ad && npm run sync:arbitration && npm run sync:family-law && npm run sync:english && npm run sync:logistics"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
